rules_version = '2';

/**
 * Firebase Firestore Security Rules
 * ==================================
 * Booking-System — Business Management Suite v2
 *
 * Architecture:
 * - Public users can ONLY create bookings (with strict validation)
 * - Admin users have full CRUD access to all business collections
 * - Admin is identified by UID: hwmYL3WsWBbuSMy1nPPOujbTt7f1
 *
 * NEVER expose read/write access to unauthenticated users beyond what's here.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // BOOKINGS COLLECTION
    // ============================================================
    match /bookings/{bookingId} {

      // ---- CREATE (Public) ----
      // Anyone can create a booking, but only with validated fields.
      allow create: if request.resource.data.keys().hasAll([
        'name', 'email', 'phone', 'date', 'time',
        'consentGiven', 'consentTimestamp', 'retentionExpiry', 'status', 'createdAt'
      ])
      // Type checks
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.phone is string
      && request.resource.data.date is string
      && request.resource.data.time is string
      && request.resource.data.consentGiven is bool
      && request.resource.data.status is string
      // Length constraints
      && request.resource.data.name.size() <= 100
      && request.resource.data.email.size() <= 254
      && request.resource.data.phone.size() <= 20
      && (request.resource.data.notes is string && request.resource.data.notes.size() <= 500
          || !request.resource.data.keys().hasAny(['notes']))
      // Consent must be explicitly true
      && request.resource.data.consentGiven == true
      // Status must start as 'pending'
      && request.resource.data.status == 'pending'
      // Created at must be a valid timestamp
      && request.resource.data.createdAt is timestamp
      && request.resource.data.consentTimestamp is timestamp
      && request.resource.data.retentionExpiry is timestamp;

      // ---- READ (Admin only) ----
      allow read: if request.auth != null
                  && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';

      // ---- UPDATE (Admin only) ----
      // Admin can update status only (prevents data tampering)
      allow update: if request.auth != null
                    && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1'
                    // Only allow updating the 'status' field
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);

      // ---- DELETE (Admin only) ----
      allow delete: if request.auth != null
                    && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';

      // ---- LIST (Admin only) ----
      allow list: if request.auth != null
                  && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // CUSTOMERS COLLECTION
    // ============================================================
    match /customers/{customerId} {
      // Admin full access
      allow read, list, delete: if request.auth != null
                                 && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
      allow create: if request.auth != null
                    && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1'
                    && request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
                    && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // QUOTES COLLECTION
    // ============================================================
    match /quotes/{quoteId} {
      allow read, list, create, update, delete: if request.auth != null
                                                && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // INVOICES COLLECTION
    // ============================================================
    match /invoices/{invoiceId} {
      allow read, list, create, update, delete: if request.auth != null
                                                && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // STAFF COLLECTION
    // ============================================================
    match /staff/{staffId} {
      allow read, list, create, update, delete: if request.auth != null
                                                && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // ROTA COLLECTION
    // ============================================================
    match /rota/{shiftId} {
      allow read, list, create, update, delete: if request.auth != null
                                                && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // SETTINGS COLLECTION
    // ============================================================
    match /settings/{settingId} {
      allow read, list, create, update, delete: if request.auth != null
                                                && request.auth.uid == 'hwmYL3WsWBbuSMy1nPPOujbTt7f1';
    }

    // ============================================================
    // DENY ALL OTHER ACCESS
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}