# Booking-System Environment Variables
# =====================================
# Copy this file to .env and fill in your Firebase project details.
# These are PUBLIC values — they are safe to expose in client-side code.
# NEVER store server-side secrets (API keys, admin UIDs, etc.) here.

# Firebase Configuration
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Admin Configuration
ADMIN_UID=your-admin-firebase-uid

# EmailJS Configuration (for booking notifications)
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Logging
LOG_LEVEL=verbose  # Change to 'minimal' for production